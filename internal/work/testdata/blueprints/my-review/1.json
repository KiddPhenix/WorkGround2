{
  "schemaVersion": 1,
  "id": "blueprint:my-review",
  "version": 1,
  "name": "我的审查",
  "description": "自定义代码审查模板 v1",
  "source": "user",
  "inputSchema": {
    "type": "object",
    "properties": {
      "target": {"type": "string", "description": "审查目标"},
      "strictness": {"type": "string", "enum": ["loose", "normal", "strict"]}
    },
    "required": ["target"]
  },
  "promptTemplate": "审查 {{.target}}，严格程度 {{.strictness}}",
  "workflow": {
    "stages": [
      {
        "id": "my-scan",
        "title": "扫描",
        "tasks": [{"id": "my-read", "title": "读取代码"}]
      },
      {
        "id": "my-review",
        "title": "审查",
        "tasks": [{"id": "my-check", "title": "逐项检查"}]
      }
    ]
  },
  "blockSpecs": [
    {
      "id": "my-issues",
      "kind": "checklist",
      "schemaVersion": 1,
      "label": "问题清单",
      "placement": {"slot": "primary", "order": 0},
      "editable": true
    }
  ],
  "toolContracts": [],
  "createdAt": "2026-07-20T00:00:00Z"
}
